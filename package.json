{
  "name": "forma-facile-parametro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "dev:safe": "vite --host 127.0.0.1 --port 3000",
    "preview:safe": "vite preview --host 127.0.0.1 --port 8080",
    "dev:5274": "vite --host 127.0.0.1 --port 5274",
    "preview:5274": "vite preview --host 127.0.0.1 --port 5274",
    "test": "jest",
    "test:cad": "cross-env RUN_CAD_INTEGRATION=1 npm test -- src/lib/__tests__/cadAnalysis.test.ts src/lib/tests/cadOcct.integration.test.ts --runInBand",
    "test:cad:strict": "cross-env RUN_CAD_INTEGRATION=1 CAD_STRICT=1 npm test -- src/lib/tests/cadOcct.integration.test.ts --runInBand",
    "test:all": "cross-env RUN_CAD_INTEGRATION=1 npm test",
    "build:sign": "node ./scripts/sign-calc.cjs",
    "generate:pdf": "node ./scripts/generate-specs-pdf.cjs",
    "copy-occt": "node ./scripts/copy-occt-dist.cjs",
    "postinstall": "npm run copy-occt",
    "electron:dev": "concurrently \"npm run dev\" \"npx wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npx electron-builder",
    "e2e": "concurrently \"npm run dev\" \"npx wait-on http://localhost:5173 && npx playwright test\"",
    "e2e:simulate": "node scripts/e2e-simulate-upload.mjs",
    "test:e2e": "playwright test"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.forma.facile.parametro",
    "files": [
      "dist/**",
      "electron/**",
      "node_modules/**"
    ],
    "directories": {
      "buildResources": "build"
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "fabric": "^6.7.1",
    "helmet": "^8.1.0",
    "html-to-text": "^9.0.5",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "markdown-it": "^14.1.0",
    "multer": "^1.4.5-lts.1",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "occt-import-js": "^0.0.23",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-day-picker": "^9.10.0",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^6.30.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.180.0",
    "uuid": "^9.0.1",
    "vaul": "^1.1.2",
    "winston": "^3.17.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.57.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.8",
    "@types/winston": "^2.4.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^26.6.10",
    "electron-builder": "^24.13.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jest": "^30.1.3",
    "playwright": "^1.40.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^5.4.20",
    "vite-tsconfig-paths": "^4.3.2",
    "wait-on": "^6.0.1"
  }
}
