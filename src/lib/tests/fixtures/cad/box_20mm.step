ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Box 20mm'),'2;1');
FILE_NAME('box_20mm.step','2025-12-16T00:00:00',(''),(''),'forma-facile','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN_CC2')); 
ENDSEC;
DATA;
/*
   Simple STEP file describing a 20x20x20 box as a closed shell / manifold solid BREP.
   Coordinates: corner at (0,0,0) to (20,20,20) in mm.
   This is a compact, explicit BREP representation sufficient for OCCT to parse.
*/

#1 = CARTESIAN_POINT('P1',(0.0,0.0,0.0));
#2 = CARTESIAN_POINT('P2',(20.0,0.0,0.0));
#3 = CARTESIAN_POINT('P3',(20.0,20.0,0.0));
#4 = CARTESIAN_POINT('P4',(0.0,20.0,0.0));
#5 = CARTESIAN_POINT('P5',(0.0,0.0,20.0));
#6 = CARTESIAN_POINT('P6',(20.0,0.0,20.0));
#7 = CARTESIAN_POINT('P7',(20.0,20.0,20.0));
#8 = CARTESIAN_POINT('P8',(0.0,20.0,20.0));

#9 = DIRECTION('ZDIR',(0.,0.,1.));
#10 = DIRECTION('YDIR',(0.,1.,0.));
#11 = DIRECTION('XDIR',(1.,0.,0.));

#12 = AXIS2_PLACEMENT_3D('AP1',#1,#9,#11);
#13 = AXIS2_PLACEMENT_3D('AP2',#5,#9,#11);

/* Define 6 planar faces by plane + outer loops built from edges between points */

/* bottom face (P1,P2,P3,P4) */
#20 = VERTEX_POINT('',#1);
#21 = VERTEX_POINT('',#2);
#22 = VERTEX_POINT('',#3);
#23 = VERTEX_POINT('',#4);

#30 = EDGE_CURVE('',#20,#21,#40,.T.);
#31 = EDGE_CURVE('',#21,#22,#41,.T.);
#32 = EDGE_CURVE('',#22,#23,#42,.T.);
#33 = EDGE_CURVE('',#23,#20,#43,.T.);

#40 = LINE('',#1,#11);
#41 = LINE('',#2,#11);
#42 = LINE('',#3,#11);
#43 = LINE('',#4,#11);

#50 = ORIENTED_EDGE('',*,#30,.T.);
#51 = ORIENTED_EDGE('',*,#31,.T.);
#52 = ORIENTED_EDGE('',*,#32,.T.);
#53 = ORIENTED_EDGE('',*,#33,.T.);

#60 = EDGE_LOOP('',(#50,#51,#52,#53));
#61 = PLANE('',#12);
#62 = FACE_OUTER_BOUND('',#60,.T.);
#63 = ADVANCED_FACE('',(#62),#61,.T.);

/* top face (P5,P6,P7,P8) */
#70 = VERTEX_POINT('',#5);
#71 = VERTEX_POINT('',#6);
#72 = VERTEX_POINT('',#7);
#73 = VERTEX_POINT('',#8);

#80 = EDGE_CURVE('',#70,#71,#84,.T.);
#81 = EDGE_CURVE('',#71,#72,#85,.T.);
#82 = EDGE_CURVE('',#72,#73,#86,.T.);
#83 = EDGE_CURVE('',#73,#70,#87,.T.);

#84 = LINE('',#5,#11);
#85 = LINE('',#6,#11);
#86 = LINE('',#7,#11);
#87 = LINE('',#8,#11);

#90 = ORIENTED_EDGE('',*,#80,.T.);
#91 = ORIENTED_EDGE('',*,#81,.T.);
#92 = ORIENTED_EDGE('',*,#82,.T.);
#93 = ORIENTED_EDGE('',*,#83,.T.);

#100 = EDGE_LOOP('',(#90,#91,#92,#93));
#101 = AXIS2_PLACEMENT_3D('AP_TOP',#5,#9,#11);
#102 = PLANE('',#101);
#103 = FACE_OUTER_BOUND('',#100,.T.);
#104 = ADVANCED_FACE('',(#103),#102,.T.);

/* Four side faces (constructed roughly) */

/* side 1: P1->P2->P6->P5 */
#110 = EDGE_LOOP('',(#50,#31,#80,#53));
#111 = PLANE('',#12);
#112 = FACE_OUTER_BOUND('',#110,.T.);
#113 = ADVANCED_FACE('',(#112),#111,.T.);

/* side 2: P2->P3->P7->P6 */
#120 = EDGE_LOOP('',(#31,#51,#81,#80));
#121 = PLANE('',#12);
#122 = FACE_OUTER_BOUND('',#120,.T.);
#123 = ADVANCED_FACE('',(#122),#121,.T.);

/* side 3: P3->P4->P8->P7 */
#130 = EDGE_LOOP('',(#51,#52,#82,#81));
#131 = PLANE('',#12);
#132 = FACE_OUTER_BOUND('',#130,.T.);
#133 = ADVANCED_FACE('',(#132),#131,.T.);

/* side 4: P4->P1->P5->P8 */
#140 = EDGE_LOOP('',(#52,#53,#83,#82));
#141 = PLANE('',#12);
#142 = FACE_OUTER_BOUND('',#140,.T.);
#143 = ADVANCED_FACE('',(#142),#141,.T.);

/* closed shell and solid */
#200 = CLOSED_SHELL('',(#63,#104,#113,#123,#133,#143));
#201 = MANIFOLD_SOLID_BREP('',#200);

#300 = GEOMETRIC_REPRESENTATION_CONTEXT('',3,1.0E-5);
#400 = PRODUCT_DEFINITION('Box','20mm box','',#401);
#401 = PRODUCT_DEFINITION_FORMATION('box_shape','',#402);
#402 = PRODUCT('Box20','Box','');

ENDSEC;
END-ISO-10303-21;
